# VistaraBI Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# AI Configuration - Multi-Provider Fallback
# ==========================================
# Priority: NVIDIA NIM → Groq → OpenRouter → Ollama Local
# Configure at least one provider for production use.

# ── 1. NVIDIA NIM (Recommended — Enterprise AI Inference) ──────────────────
# Get a FREE API key at: https://build.nvidia.com  (log in → API Key)
# 100+ curated models including Llama 3.3, Nemotron, Mistral, Gemma, Qwen.
# All models expose OpenAI-compatible endpoints — plug-and-play.
#
# Recommended models for VistaraBI:
#   meta/llama-3.3-70b-instruct              — best all-round accuracy
#   nvidia/llama-3.1-nemotron-ultra-253b-v1  — highest reasoning quality
#   mistralai/mistral-large-2-instruct       — fast structured output
#   google/gemma-3-27b-it                    — lightweight summaries
#   qwen/qwen2.5-72b-instruct                — multilingual & coding
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── 2. Groq (Fast Cloud Fallback — Free Tier) ──────────────────────────────
# Get a free key at: https://console.groq.com
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── 3. OpenRouter (Multi-Model Cloud Fallback) ─────────────────────────────
# Get a key at: https://openrouter.ai
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── 4. Ollama Cloud (Optional — self-hosted Ollama instance) ───────────────
# OLLAMA_CLOUD_URL=https://your-cloud-ollama.com
# OLLAMA_CLOUD_API_KEY=your-key
# OLLAMA_CLOUD_MODEL=qwen3.5:397b

# ── 5. Ollama Local (Dev only — privacy-first, no internet) ────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b

# ── Routing preference ──────────────────────────────────────────────────────
# PREFER_LOCAL=true   → Ollama first, then cloud fallback
# FORCE_GROQ=true     → Always use Groq (overrides PREFER_LOCAL)
PREFER_LOCAL=false
# NEXT_PUBLIC_DEFAULT_AI_MODE=auto
# ENABLE_CLOUD_ROUTING=false

# Qwen Cloud (DashScope) - Module 6 specific
# QWEN_API_KEY=your-dashscope-api-key
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==========================================
# Authentication & Security
# ==========================================
# Generate secure random strings for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=vistarabi-dev-jwt-secret-2024-change-in-production
NEXTAUTH_SECRET=vistarabi-dev-nextauth-secret-2024-change-in-production

# ==========================================
# Database
# ==========================================
# For production serverless environments, append: ?connection_limit=5&pool_timeout=20
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vistarabi?connection_limit=5&pool_timeout=20


# ==========================================
# Application
# ==========================================
# Set to production URL when deploying
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Production Settings
# ==========================================
# Set to 'production' in production environment
NODE_ENV=development

# Enable detailed logging in development
DEBUG=false
