# VistaraBI Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# AI Configuration - Multi-Provider Fallback
# ==========================================
# Priority: Ollama (local) → Ollama (cloud) → OpenRouter
# Configure at least one provider for production use

# 1. Ollama Local (Primary - Highest Priority)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b

# 2. Ollama Cloud (Optional - Secondary Fallback)
# Uncomment to enable cloud Ollama as fallback
# OLLAMA_CLOUD_URL=https://your-ollama-cloud-instance.com
# OLLAMA_CLOUD_API_KEY=your-cloud-api-key
# OLLAMA_CLOUD_MODEL=qwen3.5:397b

# 3. OpenRouter (Optional - Final Fallback)
# Uncomment to enable OpenRouter as final fallback
# Provides access to Claude, GPT-4, and other models
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 4. Groq (Cloud-First Priority - Highly Recommended)
# VistaraBI defaults to Cloud-First orchestration. Set GROQ_API_KEY to enable this.
# If Groq fails or rate-limits, it will automatically fall back to Ollama Local.
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# PREFER_LOCAL=true
# NEXT_PUBLIC_DEFAULT_AI_MODE=auto
# Optional hard-disable local everywhere (overrides UI toggle):
# FORCE_GROQ=false

# Legacy Cloud AI Config (for backward compatibility)
# These are used by Module 6 cloud adapter if ENABLE_CLOUD_ROUTING=true
# CLOUD_AI_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_AI_API_KEY=your-groq-api-key
# CLOUD_AI_MODEL=llama3-70b-8192
# ENABLE_CLOUD_ROUTING=false

# Qwen Cloud (DashScope) - Module 6 specific
# QWEN_API_KEY=your-dashscope-api-key
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==========================================
# Authentication & Security
# ==========================================
# Generate secure random strings for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=vistarabi-dev-jwt-secret-2024-change-in-production
NEXTAUTH_SECRET=vistarabi-dev-nextauth-secret-2024-change-in-production

# ==========================================
# Database
# ==========================================
# For production serverless environments, append: ?connection_limit=5&pool_timeout=20
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vistarabi?connection_limit=5&pool_timeout=20


# ==========================================
# Application
# ==========================================
# Set to production URL when deploying
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Production Settings
# ==========================================
# Set to 'production' in production environment
NODE_ENV=development

# Enable detailed logging in development
DEBUG=false
