{
  "name": "vistarabi-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:unit": "vitest run --exclude **/tests/e2e-all-modules.test.ts --exclude **/*.e2e.ts",
    "test:integration": "vitest run tests/e2e-all-modules.test.ts",
    "test:1-2": "vitest run tests/module-1-2",
    "test:3": "vitest run tests/module-3",
    "test:4d": "vitest run tests/module-4d",
    "test:5a": "vitest run tests/module-5a",
    "test:5b": "vitest run tests/module-5b",
    "test:5c": "vitest run tests/module-5c",
    "test:module-5": "vitest run tests/module-5",
    "test:6": "vitest run tests/module-6",
    "test:7": "vitest run tests/module-7",
    "test:8": "vitest run tests/module-8",
    "test:9": "vitest run tests/module-9",
    "test:ci": "vitest run --exclude **/ollama-integration.test.ts --exclude **/e2e-all-modules.test.ts --exclude **/*.e2e.ts",
    "test:ci:live-ai": "vitest run tests/module1.e2e.ts tests/integration.e2e.ts tests/e2e-all-modules.test.ts --exclude **/ollama-integration.test.ts",
    "test:ui": "vitest --ui",
    "analyze": "ANALYZE=true next build",
    "profile:domain": "npx tsx scripts/profile-domain-datasets.ts",
    "ingest:retail": "npx tsx scripts/ingest-and-tune.ts RETAIL",
    "seed:demo": "node prisma/seed-demo.mjs",
    "sam:audit:release": "node sam/scripts/module-workflow-audit.js",
    "sam:tdd:modules": "node sam/scripts/module-workflow-audit.js --strict"
  },
  "prisma": {
    "seed": "node prisma/seed-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^1.52.0",
    "@prisma/client": "5.10.2",
    "@react-pdf/renderer": "^4.3.2",
    "@types/pg": "^8.16.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.1.1",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.18.0",
    "plotly.js-dist-min": "^3.5.1",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-plotly.js": "^2.6.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@faker-js/faker": "^10.3.0",
    "@next/bundle-analyzer": "^16.2.4",
    "@tailwindcss/postcss": "^4",
