generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // GDPR: soft-delete timestamp; hard delete runs after 30 days
  projects  Project[]
}

model Project {
  id                    String                @id @default(uuid())
  userId                String
  name                  String
  description           String?
  createdAt             DateTime              @default(now())
  aiDomainReasoning     AIDomainReasoning?
  aiKpiProposals        AIKpiProposal[]
  dashboardConfig       DashboardConfig?
  dashboardState        DashboardState?
  dataLineage           DataLineage?
  domainDetection       DomainDetection?
  domainGovernance      DomainGovernance?
  domainHistories       DomainHistory[]
  kpiBlueprint          KPIBlueprint?
  kpiBlueprintHistories KPIBlueprintHistory[]
  kpiDiscovery          KPIDiscovery?
  kpiLineageRegistry    KPILineageRegistry?
  user                  User                  @relation(fields: [userId], references: [id])
  projectGoals          ProjectGoal[]
  relationships         Relationship[]
  relationshipRegistry  RelationshipRegistry?
  sources               Source[]
}

model Source {
  id                   String                @id @default(uuid())
  projectId            String
  fileName             String
  fileType             String
  status               SourceStatus          @default(PENDING)
  rowCount             Int                   @default(0)
  colCount             Int                   @default(0)
  columns              String[]
  data                 Json
  qualityScore         QualityScore?
  error                String?
  uploadedAt           DateTime              @default(now())
  cleanedDataset       CleanedDataset?
  cleaningLog          CleaningLog?
  columnHealths        ColumnHealth[]
  columnMetas          ColumnMeta[]
  outlierRecords       OutlierRecord[]
  qualityIntelligence  QualityIntelligence?
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transformationAudits TransformationAudit[]

  @@index([projectId, status])
}

model ColumnMeta {
  id             String   @id @default(uuid())
  sourceId       String
  originalName   String
  normalizedName String
  dataType       DataType
  nullPercent    Float
  uniquePercent  Float
  sampleValues   Json
  source         Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model Relationship {
  id          String  @id @default(uuid())
  projectId   String
  sourceAId   String
  sourceBId   String
  sourceAName String
  sourceBName String
  columnA     String
  columnB     String
  confidence  Float
  matchType   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CleanedDataset {
  id              String         @id @default(uuid())
  sourceId        String         @unique
  cleanedData     Json
  cleanedRowCount Int
  cleanedColCount Int
  cleanedColumns  String[]
  status          CleaningStatus
  error           String?
  cleanedAt       DateTime       @default(now())
  source          Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model CleaningLog {
  id                   String   @id @default(uuid())
  sourceId             String   @unique
  nullsFilled          Int
  duplicatesRemoved    Int
  datesNormalized      Int
  currenciesNormalized Int
  textsStandardized    Int
  emptyColumnsRemoved  Int
  originalRowCount     Int
  cleanedRowCount      Int
  createdAt            DateTime @default(now())
  source               Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model QualityIntelligence {
  id                String       @id @default(uuid())
  sourceId          String       @unique
  overallGrade      QualityGrade
  completenessScore Float
  consistencyScore  Float
  accuracyScore     Float
  riskLevel         RiskLevel
  totalRecords      Int
  healthyRecords    Int
  riskyRecords      Int
  calculatedAt      DateTime     @default(now())
  source            Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model ColumnHealth {
  id           String       @id @default(uuid())
  sourceId     String
  columnName   String
  healthStatus HealthStatus
  completeness Float
  consistency  Float
  outlierCount Int
  uniqueness   Float
  issues       String[]
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model OutlierRecord {
  id              String  @id @default(uuid())
  sourceId        String
  columnName      String
  rowIndex        Int
  value           Json
  detectionMethod String
  severity        String
  expectedRange   String?
  source          Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model TransformationAudit {
  id                 String   @id @default(uuid())
  sourceId           String
  transformationType String
  affectedColumn     String?
  affectedRowCount   Int
  beforeValue        String?
  afterValue         String?
  timestamp          DateTime @default(now())
  source             Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model DomainDetection {
  id               String       @id @default(uuid())
  projectId        String       @unique
  detectedDomain   DomainType?
  confidence       Float
  status           DomainStatus
  scoringBreakdown Json
  matchedColumns   String[]
  explanation      String
  detectedAt       DateTime     @default(now())
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DomainGovernance {
  id               String           @id @default(uuid())
  projectId        String           @unique
  activeDomain     DomainType?
  governanceStatus GovernanceStatus
  isLocked         Boolean
  version          Int
  changedBy        String
  changeReason     String
  lastUpdated      DateTime         @default(now())
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DomainHistory {
  id             String           @id @default(uuid())
  projectId      String
  version        Int
  previousDomain DomainType?
  newDomain      DomainType?
  previousStatus GovernanceStatus
  newStatus      GovernanceStatus
  changedBy      String
  changeReason   String
  confidence     Float
  changedAt      DateTime         @default(now())
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AIDomainReasoning {
  id                      String      @id @default(uuid())
  projectId               String      @unique
  ruleBasedDomain         DomainType?
  ruleBasedConfidence     Float
  matchedColumns          String[]
  unmatchedColumns        String[]
  aiRecommendedDomain     DomainType?
  aiSemanticConfidence    Float
  aiAlternativeDomain     DomainType?
  aiAlternativeConfidence Float
  aiReasoning             String
  aiSemanticSignals       String[]
  aiColumnInsights        String
  combinedConfidence      Float
  finalDomain             DomainType?
  wasAutoAssigned         Boolean
  ollamaModel             String
  processingTimeMs        Int
  createdAt               DateTime    @default(now())
  project                 Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KPIDiscovery {
  id                String     @id @default(uuid())
  projectId         String     @unique
  domain            DomainType
  totalKPIsAnalyzed Int
  computableKPIs    Json[]
  partialKPIs       Json[]
  availableColumns  String[]
  sampleData        Json?
  discoveredAt      DateTime   @default(now())
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KPIBlueprint {
  id        String        @id @default(uuid())
  projectId String        @unique
  domain    String        @default("GENERAL")
  version   Int           @default(1)
  isLocked  Boolean       @default(false)
  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  kpis      ApprovedKPI[]
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ApprovedKPI {
  id           String              @id @default(uuid())
  blueprintId  String
  kpiLibraryId String?
  name         String
  description  String?
  sourceTable  String
  category     String              @default("general")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  unit         String?
  aggregations AggregationRule[]
  blueprint    KPIBlueprint        @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  groupBys     GroupByDefinition[]
  lineage      LineageDefinition?

  @@index([blueprintId])
  @@index([kpiLibraryId])
}

model AggregationRule {
  id       String              @id @default(uuid())
  kpiId    String
  function AggregationFunction
  column   String
  kpi      ApprovedKPI         @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

model GroupByDefinition {
  id     String      @id @default(uuid())
  kpiId  String
  column String
  kpi    ApprovedKPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

model LineageDefinition {
  id      String      @id @default(uuid())
  kpiId   String      @unique
  formula String
  tables  Json
  joins   Json
  kpi     ApprovedKPI @relation(fields: [kpiId], references: [id], onDelete: Cascade)
}

model KPIBlueprintHistory {
  id        String   @id @default(uuid())
  projectId String
  version   Int
  action    String
  kpiId     String
  kpiName   String
  changedBy String
  changedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AIKpiProposal {
  id              String    @id @default(uuid())
  projectId       String
  kpiName         String
  formula         String
  rationale       String
  confidenceScore Float
  proposedAt      DateTime  @default(now())
  status          String
  metadata        Json?
  reviewedAt      DateTime?
  reviewedBy      String?
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DataLineage {
  id          String   @id @default(uuid())
  projectId   String   @unique
  entityGraph Json
  kpiLineages Json
  generatedAt DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RelationshipRegistry {
  id          String   @id @default(uuid())
  projectId   String   @unique
  entries     Json
  generatedAt DateTime @default(now())
  version     Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KPILineageRegistry {
  id          String   @id @default(uuid())
  projectId   String   @unique
  entries     Json
  generatedAt DateTime @default(now())
  version     Int
  stats       Json
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DashboardConfig {
  id            String   @id @default(uuid())
  projectId     String   @unique
  sections      Json
  sidebarConfig Json
  metadata      Json
  version       Int
  generatedAt   DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DashboardState {
  id            String          @id @default(uuid())
  projectId     String          @unique
  domain        String
  version       Int             @default(1)
  globalFilters Json
  granularity   String          @default("monthly")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  cards         DashboardCard[]
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DashboardCard {
  id              String         @id @default(uuid())
  stateId         String
  kpiId           String
  kpiName         String
  chartType       String
  cardSize        String         @default("md")
  position        Int
  colSpan         Int            @default(1)
  rowSpan         Int            @default(1)
  groupBy         String?
  filterOverrides Json
  comparisonMode  String?
  isPinned        Boolean        @default(false)
  isAIGenerated   Boolean        @default(false)
  isDrillDown     Boolean        @default(false)
  parentCardId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  state           DashboardState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId])
  @@index([kpiId])
}

model AuditLog {
  id                     String   @id @default(uuid())
  sessionId              String
  userId                 String?
  intentId               String   @unique
  rawUserQuery           String
  normalizedUserQuery    String
  llmRawOutput           String?
  validationStagesPassed Int      @default(0)
  validationFailedAt     String?
  structuredCommand      Json?
  executionStatus        String
  errorCode              String?
  createdAt              DateTime @default(now())

  @@index([sessionId])
  @@index([intentId])
  @@index([createdAt])
}

model ProjectGoal {
  id            String   @id @default(uuid())
  projectId     String
  rawQuery      String
  targetKpiId   String?
  targetValue   String
  timeframe     String
  generatedPlan Json
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DataType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
}

enum QualityScore {
  GOOD
  PARTIAL
  POOR
}

enum CleaningStatus {
  CLEANING
  CLEANED
  FAILED
}

enum QualityGrade {
  A
  B
  C
  D
  F
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum HealthStatus {
  GOOD
  PARTIAL
  POOR
}

enum DomainType {
  ECOMMERCE
  SAAS
  EDTECH
  RETAIL
  SERVICES
  MANUFACTURING
  HEALTHCARE
  FINANCE
}

enum DomainStatus {
  AUTO_ASSIGNED
  MANUAL_REQUIRED
  MANUALLY_SELECTED
}

enum GovernanceStatus {
  AUTO
  MANUAL
  LOCKED
}

enum RelationshipType {
  PRIMARY_KEY
  FOREIGN_KEY
  LOOKUP
}

enum DetectionMethod {
  NAME_MATCH
  VALUE_OVERLAP
  UNIQUENESS
  AI_VALIDATED
  COMPOSITE
}

enum JoinCardinality {
  ONE_TO_ONE
  ONE_TO_MANY
  MANY_TO_MANY
}

enum AggregationFunction {
  SUM
  COUNT
  COUNT_DISTINCT
  AVG
  MIN
  MAX
}
