# VistaraBI .dockerignore
# Keep Docker build context lean

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next
out

# Git
.git
.gitignore
.gitattributes

# Dev / local
.env.local
.env.development
*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode
.idea
*.swp
*.swo

# Tests
coverage
*.test.ts
*.spec.ts
__tests__

# Large raw datasets (only copy the demo folder)
datasets/ecommerce
datasets/saas
datasets/retail
datasets/edtech
datasets/manufacturing
datasets/healthcare
datasets/finance
datasets/services

# Agent / skill files (not needed at runtime)
.agent

# Logs
logs
*.log
